From 640f6a81ad5889f02656cc26ec1b56045f34ee2f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Jan=20Drl=C3=BD?= <jd@jandrly.cz>
Date: Sat, 17 Oct 2026 23:17:44 +0200
Subject: [PATCH 1/3] sm3: Leave .w of crs unwritten instead of asserting

crs has no .w result, so a write mask with .w is invalid D3D9, but the
converter built a vec4 type from three components and asserted in
composite() (an abort in builds with asserts); crs r.w alone gave a null
def. Strip .w from the mask and leave it unwritten; with nothing left,
write nothing.

26f0221 fixed the other half of the original patch (the write mask
applied twice in crs and setp) upstream.
---
 sm3/sm3_converter.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/sm3/sm3_converter.cpp b/sm3/sm3_converter.cpp
index 9968b87..f47b3d5 100644
--- a/sm3/sm3_converter.cpp
+++ b/sm3/sm3_converter.cpp
@@ -1718,6 +1718,15 @@ bool Converter::handleCrs(ir::Builder& builder, const Instruction& op) {
   WriteMask writeMask = dst.getWriteMask(m_parser.getShaderInfo());
   auto scalarType = dst.isPartialPrecision() ? ir::ScalarType::eMinF16 : ir::ScalarType::eF32;
 
+  /* There is no .w result. A mask with .w is invalid, leave .w unwritten. */
+  if (writeMask & ComponentBit::eW) {
+    writeMask &= ComponentBit::eX | ComponentBit::eY | ComponentBit::eZ;
+    dst = dst.setWriteMask(writeMask);
+
+    if (writeMask == WriteMask())
+      return true;
+  }
+
   auto src0 = loadSrcModified(builder, op, op.getSrc(0u), ComponentBit::eX | ComponentBit::eY | ComponentBit::eZ, scalarType);
   auto src1 = loadSrcModified(builder, op, op.getSrc(1u), ComponentBit::eX | ComponentBit::eY | ComponentBit::eZ, scalarType);
 
