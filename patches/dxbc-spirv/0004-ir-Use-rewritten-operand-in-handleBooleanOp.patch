From f528e1e821527e361f34829f78d1fbd5340e6f6a Mon Sep 17 00:00:00 2001
From: Danylo Piliaiev <dpiliaiev@igalia.com>
Date: Mon, 2 Nov 2026 12:38:38 +0100
Subject: [PATCH] ir: Use rewritten operand in handleBooleanOp instead of the
 original.

Gather conditions from the other operand as already rewritten in
newOp, not from the original instruction. Otherwise both operands
get simplified based on each other's original value, and duplicate
conditions such as:
 a = (x != 0)
 b = (x != 0)
 result = a && b
would be optimized to `result = true`.

Fixes "V Rising" after it regressed due to
76236b8 ("ir: More aggressively evaluate comparisons.")

Signed-off-by: Danylo Piliaiev <dpiliaiev@igalia.com>
---
 ir/passes/ir_pass_conditions.cpp | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ir/passes/ir_pass_conditions.cpp b/ir/passes/ir_pass_conditions.cpp
index a27898f9..48867f54 100644
--- a/ir/passes/ir_pass_conditions.cpp
+++ b/ir/passes/ir_pass_conditions.cpp
@@ -353,8 +353,17 @@ std::pair<bool, Builder::iterator> ConditionPass::handleBooleanOp(Builder::itera
   Op newOp = *op;
 
   for (uint32_t i = 0u; i < 2u; i++) {
-    const auto& a = m_builder.getOpForOperand(*op, i);
-    const auto& b = m_builder.getOpForOperand(*op, i ^ 1);
+    /* Gather conditions from the other operand as already rewritten in
+     * newOp, not from the original instruction. Otherwise both operands
+     * get simplified based on each other's original value, and duplicate
+     * conditions such as:
+     *  a = (x != 0)
+     *  b = (x != 0)
+     *  result = a && b
+     * would be optimized to `result = true`.
+     */
+    const auto& a = m_builder.getOpForOperand(newOp, i);
+    const auto& b = m_builder.getOpForOperand(newOp, i ^ 1);
 
     small_vector<Condition, 256> conditions;
 
