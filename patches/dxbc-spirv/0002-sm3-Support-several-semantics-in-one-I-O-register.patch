+const IoVarInfo* IoMap::findIoVar(RegisterType regType, uint32_t regIndex, uint32_t component) const {
+  /* Distance from the component to the entry's mask: 0 if it covers it,
+   * 1-3 for the nearest covered component below, 5-7 above. */
+  const IoVarInfo* result = nullptr;
+  uint32_t resultDistance = ~0u;
+
+  for (auto& e : m_variables) {
+    if (e.registerType != regType || e.registerIndex != regIndex)
+      continue;
+
+    uint32_t mask = uint8_t(e.componentMask);
+    uint32_t below = mask & ((1u << component) - 1u);
+    uint32_t above = mask & ~((2u << component) - 1u);
+    uint32_t distance = 8u;
+
+    if (mask & (1u << component))
+      distance = 0u;
+    else if (below)
+      distance = component - uint32_t(util::findmsb(below));
+    else if (above)
+      distance = 4u + util::tzcnt(above) - component;
+
+    if (distance < resultDistance) {
+      result = &e;
+      resultDistance = distance;
+    }
+  }
+
+  return result;
+}
+
+
+bool IoMap::isPackedRegister(RegisterType regType, uint32_t regIndex) const {
+  uint32_t count = 0u;
+
+  for (auto& e : m_variables) {
+    if (e.registerType == regType && e.registerIndex == regIndex)
+      count++;
+  }
+
+  return count > 1u;
+}
