# build artifacts
build/
dist/
# host-only tooling clone (re-clone: git clone https://github.com/apple/metal-cpp)
third_party/metal-cpp/
# offscreen example outputs
examples/triangle/triangle
examples/triangle/*.bmp
examples/triangle/*.png

# external sources (scripts/fetch-deps.sh; SPIRV-Cross only for the host AIR
# compiler dev tool, scripts/build-air-compiler.sh). No trailing slash, so a
# symlink is ignored as well.
/third_party/dxbc-spirv
/third_party/SPIRV-Cross

# upstream DXVK reference clone (scripts/audit-port-diff.sh only)
/DXVK-3.0-uptsream

# local LLVM toolchain builds (scripts/build-llvm-unixside.sh)
/toolchains

# runtime logs and captures
d9mt.log
*.gputrace/
